# Files left out of the published package. A .pubignore replaces this
# directory's .gitignore for publishing, so the generated directories are
# listed here as well as in the repository's .gitignore.
.dart_tool/
build/
coverage/
doc/api/
pubspec.lock

# Golden tests and their images are development fixtures, specific to the
# platform that generated them (macOS), so neither ships: a published golden
# test without its image would only fail.
test/**/goldens/
test/**/failures/
test/golden/layout_golden_test.dart
test/debug/debug_painter_golden_test.dart
test/debug/debug_repaint_test.dart

# This package's analysis options include the workspace root's file, which is
# not part of the published archive.
analysis_options.yaml

# The parity tooling's Flutter harness is a package of its own, set up outside
# the repository; its imports resolve only there, and without this package's
# analysis options (left out above) nothing would exclude it from analysis.
tool/parity/fl_harness/

# Flutter tool metadata for this directory.
.metadata
