# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# This repo is a pub workspace, so a single lock file lives at the workspace
# root; the unanchored pattern also covers any lock file in members.
pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Build artifacts and coverage, in every workspace member (packages/,
# website/, etc.). The root itself is a shell and builds nothing.
build/
coverage/

# Byte-code cache from the tool/ coverage scripts.
__pycache__/

# Local-only directories, excluded from VCS entirely
inspo/
playground/
